#!/usr/bin/env bash
# Base layer: everything every phone image gets, regardless of UI or device.
# Runs inside the container build with this folder as the working directory.
# Files under ./rootfs are already installed by tools/image/run-layer.
set -euxo pipefail

# Debug access without a working screen: a USB network gadget (172.16.42.1,
# the postmarketOS convention) plus sshd. See rootfs/usr/libexec/fap-usb-gadget.
dnf5 -y install openssh-server
systemctl enable sshd.service fap-usb-gadget.service

# Tools that make on-device debugging bearable.
dnf5 -y install usbutils pciutils i2c-tools dtc
