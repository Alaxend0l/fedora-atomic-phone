#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Base layer: everything every phone image gets, regardless of UI or device.
# Runs inside the build with this folder as the working directory, after
# ./packages and ./rootfs are installed (tools/image/run-layer).
set -euxo pipefail

# Debug access without a working screen: a USB network gadget (172.16.42.1,
# the postmarketOS convention), DHCP for the host, sshd. On a RAM boot
# tiny-init already set the gadget up; fap-usb-gadget.service then skips.
systemctl enable sshd.service fap-usb-gadget.service fap-usb-dhcp.service

systemctl enable NetworkManager.service ModemManager.service bluetooth.service chronyd.service
