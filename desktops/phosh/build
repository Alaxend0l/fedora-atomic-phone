#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Phosh: GNOME-based phone shell. ./packages is the explicit package list;
# this script only configures. Runs inside the build (tools/image/run-layer).
set -euxo pipefail

# phrog is the greeter (greetd + phosh); it owns display-manager.service.
systemctl enable --force phrog.service
systemctl set-default graphical.target
