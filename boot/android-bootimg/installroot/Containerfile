# Development install root: the netroot (kernel modules, our out-of-tree
# drivers + firmware, SSH, fap-modem-ram) plus Plasma Mobile. Installed as a
# plain ext4 root (label fap-root) and booted by tiny-init's fap.root=. Not the
# bootc image yet; see boot/android-bootimg/README.md. SDDM replaces Fedora
# 45's default Plasma Login so autologin is a plain config file.
FROM localhost/fap-netroot:latest

RUN dnf5 -y install --setopt=install_weak_deps=True @kde-mobile-environment \
        NetworkManager NetworkManager-wifi dnsmasq sddm qcom-firmware \
        mesa-dri-drivers e2fsprogs sudo chrony systemd-pam \
    && dnf5 clean all

COPY rootfs/ /

# plasma-setup (KDE's first-run wizard) would replace our autologin with its
# own user; Plasma Mobile doesn't need it.
RUN useradd -m -G wheel,video,audio,input phone \
    && echo 'phone:147147' | chpasswd \
    && systemctl mask getty@tty1.service plasma-setup.service \
    && systemctl enable --force sddm.service \
    && systemctl enable NetworkManager.service fap-modem-ram.service chronyd.service fap-usb-dhcp.service \
    && systemctl set-default graphical.target \
    && echo n100 > /etc/hostname \
    && echo 'LABEL=fap-root / ext4 defaults,noatime 0 1' > /etc/fstab \
    && echo 'FD_MESA_DEBUG=noubwc' >> /etc/environment

# FD_MESA_DEBUG=noubwc: with UBWC (framebuffer compression) on, Plasma renders
# as blocky tile garbage on the N100: GPU and display disagree on UBWC
# parameters for SM6115 (kernel ubwc_config vs Mesa). Off until that's fixed.
