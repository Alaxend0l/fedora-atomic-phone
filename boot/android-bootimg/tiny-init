#!/bin/sh
# /init of the tiny RAM-boot initramfs (boot/android-bootimg/make-ramboot.sh).
# Static busybox only. Loads the device's drivers, brings up a USB serial
# (CDC-ACM) gadget with a root shell, and keeps a shell on the screen too.
# Development only: unauthenticated root shells.

export PATH=/bin
mkdir -p /proc /sys /dev /tmp /run
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
mount -t configfs configfs /sys/kernel/config 2>/dev/null
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t pstore pstore /sys/fs/pstore 2>/dev/null
echo "fap-init: starting" > /dev/kmsg

# Modules in dependency order (generated at build time).
while read -r ko; do
    insmod "$ko" 2>/dev/null || echo "fap-init: insmod $ko failed" > /dev/kmsg
done < /etc/modules.order

# USB serial gadget once the device controller shows up.
i=0
while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $i -lt 30 ]; do sleep 1; i=$((i + 1)); done
udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
if [ -n "$udc" ]; then
    G=/sys/kernel/config/usb_gadget/fap
    mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 $G/functions/acm.usb0
    # USB networking too, if the kernel has NCM (host gets an interface; the
    # phone is 172.16.42.1).
    mkdir -p $G/functions/ncm.usb0 2>/dev/null
    echo 0x1d6b > $G/idVendor
    echo 0x0104 > $G/idProduct
    echo fedora-atomic-phone > $G/strings/0x409/manufacturer
    echo "ramboot debug shell" > $G/strings/0x409/product
    echo ACM > $G/configs/c.1/strings/0x409/configuration
    ln -s $G/functions/acm.usb0 $G/configs/c.1/
    [ -d $G/functions/ncm.usb0 ] && ln -s $G/functions/ncm.usb0 $G/configs/c.1/
    echo "$udc" > $G/UDC
    if [ -d $G/functions/ncm.usb0 ]; then
        ifname=$(cat $G/functions/ncm.usb0/ifname)
        ifconfig "$ifname" 172.16.42.1 netmask 255.255.255.0 up
        ifconfig lo 127.0.0.1 up
        # Hand the host an address (172.16.42.2), then a telnet root shell.
        mkdir -p /var/lib/misc; touch /var/lib/misc/udhcpd.leases
        printf "start 172.16.42.2\nend 172.16.42.2\ninterface %s\noption subnet 255.255.255.0\n" "$ifname" > /etc/udhcpd.conf
        udhcpd /etc/udhcpd.conf
        telnetd -l /bin/sh
        echo "fap-init: USB network $ifname 172.16.42.1 (telnet)" > /dev/kmsg
    fi
    echo "fap-init: USB serial gadget up on $udc" > /dev/kmsg
else
    echo "fap-init: no USB device controller after 30 s" > /dev/kmsg
    # Show what's waiting for what, on the screen (a photo is enough to debug).
    if [ -r /sys/kernel/debug/devices_deferred ]; then
        while read -r line; do
            echo "fap-init: deferred: $line" > /dev/kmsg
        done < /sys/kernel/debug/devices_deferred
    fi
    # USB-related kernel messages last, so they end up on screen.
    dmesg | grep -iE "dwc3|usb|udc|qusb|phy" | grep -v fap-init | tail -n 12 | while read -r line; do
        echo "fap-init: usb: $line" > /dev/kmsg
    done
fi

# Installed root (kernel argument fap.root=LABEL=<label> or a device path):
# mount it read-write and switch to its systemd. The USB gadget carries over.
root=$(sed -n 's/.*fap\.root=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -n "$root" ]; then
    dev=
    i=0
    while [ $i -lt 30 ]; do
        case "$root" in
            /dev/*) [ -b "$root" ] && dev=$root ;;
            *) dev=$(findfs "$root" 2>/dev/null) ;;
        esac
        [ -n "$dev" ] && break
        sleep 1; i=$((i + 1))
    done
    mkdir -p /newroot
    if [ -n "$dev" ] && mount -t ext4 -o rw,noatime "$dev" /newroot \
            && [ -x /newroot/usr/lib/systemd/systemd ]; then
        echo "fap-init: root $root ($dev), switching to systemd" > /dev/kmsg
        killall telnetd udhcpd 2>/dev/null
        for m in /dev /proc /sys /run; do
            mkdir -p /newroot$m
            mount --move $m /newroot$m
        done
        exec switch_root /newroot /usr/lib/systemd/systemd
    fi
    echo "fap-init: root $root not usable (device: ${dev:-none}), staying here" > /dev/kmsg
    umount /newroot 2>/dev/null
fi

# Network root (kernel argument fap.netroot=http://...tar.gz): download a root
# filesystem into RAM over the USB network and switch to its systemd. The
# gadget and its network address carry over. Nothing touches the phone's
# storage. On failure, fall through to the busybox shells below.
netroot=$(sed -n 's/.*fap\.netroot=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -n "$netroot" ] && [ -n "$udc" ]; then
    mkdir -p /newroot
    mount -t tmpfs -o size=2560m,mode=0755 tmpfs /newroot
    i=0
    until wget -q -O - "$netroot" | tar -xzf - -C /newroot 2>/dev/null; do
        i=$((i + 1))
        [ $i -ge 40 ] && break
        echo "fap-init: netroot fetch failed ($i), retrying: $netroot" > /dev/kmsg
        rm -rf /newroot/* 2>/dev/null
        sleep 5
    done
    if [ -x /newroot/usr/lib/systemd/systemd ]; then
        echo "fap-init: netroot unpacked, switching to systemd" > /dev/kmsg
        killall telnetd udhcpd 2>/dev/null
        for m in /dev /proc /sys /run; do
            mkdir -p /newroot$m
            mount --move $m /newroot$m
        done
        exec switch_root /newroot /usr/lib/systemd/systemd
    fi
    echo "fap-init: netroot failed, staying in the initramfs" > /dev/kmsg
    umount /newroot 2>/dev/null
fi

# Busybox shells: on the USB serial port and on the screen.
[ -n "$udc" ] && ( while :; do setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'; sleep 1; done ) &
dmesg | tail -n 20
exec setsid cttyhack sh
