# Device description. Plain KEY=value, sourced by bash (no spaces around =).
# tools/check-device.sh lists which keys are required.
# Copy this folder to devices/<vendor>-<codename>/ and fill it in.

# --- Identity ---------------------------------------------------------------
DEVICE_NAME="Vendor Model"            # human-readable
DEVICE_CODENAME="codename"            # vendor's codename, e.g. billie2
DEVICE_SOC="qcom-sm6115"              # SoC family; matches kernels/<soc>/
DEVICE_STATUS="planned"               # planned | boots | usable | daily
DEVICE_MAINTAINER="Name <email>"

# --- Kernel -----------------------------------------------------------------
# "fedora" = Fedora's own kernel package. Otherwise a package name provided by
# the repo in KERNEL_REPO (a .repo file under rootfs/usr/share/dnf5/repos.d/).
KERNEL_PACKAGE="fedora"
# Device tree, relative to the kernel's dtb directory.
KERNEL_DTB="qcom/vendor-codename.dtb"

# --- Boot -------------------------------------------------------------------
# uboot-android: Android bootloader → U-Boot (in the boot partition) → EFI →
#                bootc's normal boot. See boot/u-boot/.
BOOT_METHOD="uboot-android"

# --- Flashing (fastboot) ----------------------------------------------------
FASTBOOT_PRODUCT=""                   # `fastboot getvar product` must contain this
FLASH_AB="true"                       # A/B slots? (boot_a/boot_b)
FLASH_BOOT_PARTITION="boot"           # gets the U-Boot image
FLASH_ERASE="dtbo"                    # space-separated partitions to erase first
FLASH_ESP_PARTITION=""                # gets the EFI system partition image
FLASH_ROOT_PARTITION="userdata"       # gets the root filesystem image

# --- Disk image -------------------------------------------------------------
DISK_SECTOR_SIZE="4096"               # UFS phones: 4096; eMMC: usually 512
