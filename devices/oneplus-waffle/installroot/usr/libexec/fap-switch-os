#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Switch to the other OS of the dual boot (INSTALL.md 5.1).
#   fap-switch-os lineage   set slot a active and reboot into LineageOS
#   fap-switch-os status    slot information (read-only)
# Refuses unless this is the image installed on slot b (fap.slot=b): never
# act on a wrong assumption. Writes only the slot attributes (qbootctl).
set -eu
log() { echo "fap-switch-os: $*"; logger -t fap-switch-os "$*" 2>/dev/null || true; }
case "${1:-}" in
    status)
        grep -o 'fap.slot=[^ ]*' /proc/cmdline || echo "fap.slot: unset"
        qbootctl
        ;;
    lineage)
        [ "$(id -u)" = 0 ] || { echo "needs root (pkexec)" >&2; exit 1; }
        grep -qw 'fap.slot=b' /proc/cmdline || { log "refused: not booted from the slot-b install image"; exit 1; }
        log "setting slot a active, rebooting into LineageOS"
        qbootctl -s a
        sync
        systemctl reboot
        ;;
    *) echo "usage: fap-switch-os lineage|status" >&2; exit 2 ;;
esac
