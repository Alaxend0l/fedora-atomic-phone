// The phone's user may switch OS without a password (the launcher still
// asks for confirmation).
polkit.addRule(function(action, subject) {
    if (action.id == "org.fedora-atomic-phone.switch-os" &&
        subject.local && subject.active && subject.user == "phone") {
        return polkit.Result.YES;
    }
});
