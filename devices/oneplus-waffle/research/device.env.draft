# SPDX-License-Identifier: AGPL-3.0-or-later
# DRAFT, not a live device folder. OnePlus 12 ("waffle", SM8650 "pineapple").
# Proposed device.env for when devices/oneplus-waffle/ becomes a device.
# Keys follow devices/oneplus-billie2/device.env; NEW_* keys are proposals
# our tooling doesn't support yet (porting-plan.md, "Tooling changes").
# Nothing below is tested on a device.

# --- Identity ---------------------------------------------------------------
DEVICE_NAME="OnePlus 12"
DEVICE_CODENAME="waffle"               # Qualcomm platform name: pineapple
DEVICE_SOC="qcom-sm8650"
DEVICE_STATUS="research"
DEVICE_MAINTAINER="Alaxend0l"
# Variants: 22877 = CPH2581 (EU), CPH2583 (NA), CPH2573 (IN); 22825 = PJD110 (CN).
NEW_DEVICE_VARIANTS="CPH2581 CPH2583 CPH2573 PJD110"

# --- Kernel -----------------------------------------------------------------
# Fedora's aarch64 kernel lacks PINCTRL_SM8650 and INTERCONNECT_QCOM_SM8650
# (rawhide/f45/f44, checked 2026-11-20) -> own build from DaDDevil/linux
# waffle-voice (v7.4-rc3 + panel/touch/haptics/battmgr) with a Fedora-based config.
KERNEL_PACKAGE="kernels/qcom-sm8650"   # proposal: out-of-Fedora kernel build
KERNEL_DTB="qcom/sm8650-oneplus-waffle.dtb"   # name used by DaDDevil's tree

# RAM-boot initramfs drivers (mainline module names): UFS + USB gadget.
# Built-in in Fedora already: RPMh, RPMHPD, RPMh regulators, SCM, SPMI arb,
# SMMU, simpledrm. pinctrl-sm8650 / qnoc-sm8650 need our config (=m or =y).
RAMBOOT_DRIVERS="pinctrl-sm8650 qnoc-sm8650 gcc-sm8650 tcsrcc-sm8650 ufs-qcom phy-qcom-qmp-ufs dwc3 dwc3-qcom phy-snps-eusb2 phy-qcom-eusb2-repeater phy-qcom-qmp-combo qcom-spmi-pmic libcomposite usb_f_acm u_serial usb_f_ncm ramoops qcom_tsens qcom-cpufreq-hw llcc-qcom"

# --- Boot -------------------------------------------------------------------
# Phase 2: android-bootimg with uniLoader (board oneplus-waffle) as the
# "kernel", carrying our Image + DTB + initramfs: ABL's DT selection never
# touches our DTB. Proven for this phone by DaDDevil (uniLoader f14ee108c9).
BOOT_METHOD="android-bootimg"
NEW_CHAINLOADER="uniloader:waffle_defconfig"   # TEXT_BASE 0xa8010000, PAYLOAD_ENTRY 0xa3200000, RAMDISK_ENTRY 0xb6f95000
# Stock: header v4 (boot + init_boot), vendor_boot carries ramdisk + DTBs,
# pagesize 4096, base 0, kernel = uncompressed Image (LineageOS BoardConfigCommon.mk:51-84).
BOOTIMG_HEADER_VERSION="4"
BOOTIMG_PAGESIZE="4096"
BOOTIMG_BASE="0x00000000"
BOOTIMG_KERNEL_OFFSET="0x00008000"    # guess: mkbootimg default; v4 boot.img has no addresses
BOOTIMG_RAMDISK_OFFSET="0x01000000"   # guess; read the real ones from stock vendor_boot
BOOTIMG_TAGS_OFFSET="0x00000100"      # guess
BOOTIMG_DTB_OFFSET="0x01f00000"       # guess
# Stock vendor cmdline is mostly bootconfig; ours: console + debug.
BOOTIMG_CMDLINE="console=tty0 clk_ignore_unused pd_ignore_unused"
# ABL wants nonzero os_version/patch level even unlocked (Xiaomi 14, SM8650);
# copy from the stock boot.img of the installed build (unknown until phase 0).
BOOTIMG_OS_VERSION=""                 # e.g. "16.0.0" from unpack_bootimg
BOOTIMG_OS_PATCH_LEVEL=""
# DT selection ids, if we ever let ABL pick our DTB (houji-style v4 layout):
NEW_QCOM_MSM_ID="<557 0x10000>, <557 0x20000>"
NEW_QCOM_BOARD_ID="<8 0>"
NEW_OPLUS_PROJECT_ID="22877"          # 22825 for PJD110
# Display handover: stock splash framebuffer.
NEW_SIMPLEFB="0xd5100000 1440x3168 a8r8g8b8"
# Crash logs: ramoops region used by DaDDevil's DT.
NEW_RAMOOPS="0x85000000 0x240000"

# --- Flashing (fastboot) ----------------------------------------------------
FASTBOOT_PRODUCT="pineapple"          # guess (board-info.txt: pineapple|OP5929L1|OP595DL1)
FLASH_AB="true"
FLASH_BOOT_PARTITION="boot"
# Phase 3 (installed): inactive slot only; stock Android stays on the other.
NEW_FLASH_TEST_SLOT="b"
# Houji recipe would also write vendor_boot_b (DT) and dtbo_b (no-op overlay
# with selection fields); with uniLoader, boot_b alone may suffice (to verify).
NEW_FLASH_EXTRA_PARTITIONS=""
FLASH_ERASE=""                        # don't erase dtbo before we know ABL's behaviour
FLASH_ESP_PARTITION=""                # undecided (no spare partition)
FLASH_ROOT_PARTITION="userdata"       # wipes Android data; f2fs on stock
# Hard deny list for tools/flash.sh (OnePlus 12 / SM8650 names):
NEW_FLASH_DENY="xbl xbl_config xbl_ramdump uefi abl tz hyp aop aop_config cpucp cpucp_dtb devcfg shrm qupfw uefisecapp keymaster imagefv featenabler oplus_sec oplusstanvbk engineering_cdt splash modem dsp bluetooth persist ocdt modemst1 modemst2 fsg fsc oplusreserve2 qmcs spunvm vbmeta_system vbmeta_vendor super"
NEW_FLASH_FORBID_SLOT_ALL="true"

# --- Disk image -------------------------------------------------------------
DISK_SECTOR_SIZE="4096"               # UFS 4.0
