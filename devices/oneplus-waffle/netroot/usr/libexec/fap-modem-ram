#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# OnePlus 12 netroot: (re)start the modem by hand and report its state.
# Since the telephony work the modem starts at boot (fap-rmtfs.service and
# friends, see that unit); this restarts the same units.
#
#   fap-modem-ram
#
# Firmware: /usr/lib/firmware/qcom/sm8650/oneplus/waffle/ (this unit's
# modem_a backup). EFS: RAM copies only (fap-efs-ram.service), served with
# rmtfs -r. The phone's own EFS partitions are never opened.
set -euo pipefail

rproc=
for r in /sys/class/remoteproc/remoteproc*; do
    case "$(cat "$r/firmware")" in */modem.mdt|*/modem.mbn) rproc=$r ;; esac
done
[ -n "$rproc" ] || { echo "no modem remoteproc (qcom_q6v5_pas not loaded?)" >&2; exit 1; }
echo "modem: $rproc ($(cat "$rproc/state")), firmware $(cat "$rproc/firmware")"
modprobe -a qrtr qrtr-smd qcom_pd_mapper
[ -e /dev/qcom_rmtfs_mem1 ] || { echo "no /dev/qcom_rmtfs_mem1 (rmtfs_mem, reserved-memory rmtfs@d7c00000)" >&2; exit 1; }

systemctl reset-failed fap-rmtfs.service fap-tqftpserv.service 2>/dev/null || true
systemctl restart fap-efs-ram.service fap-tqftpserv.service fap-rmtfs.service
for _ in $(seq 30); do
    [ "$(cat "$rproc/state")" = running ] && break
    sleep 1
done
echo "modem: $(cat "$rproc/state")"
