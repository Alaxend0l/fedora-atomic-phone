# DHCP for the host on the USB gadget network (phone 172.16.42.1, host
# 172.16.42.2), as boot/android-bootimg/installroot's fap-usb-dhcp.service in
# main. tiny-init's udhcpd ends at switch_root; once pmic-glink/the USB role
# re-enumerates the link (v5, 2026-11-20) the host asks again and nobody
# answered. No DNS, no gateway: USB is for SSH. The address is re-applied
# first in case the interface came back without it.
[Unit]
Description=DHCP for the host on the USB gadget network
After=network-pre.target

[Service]
ExecStartPre=-/usr/sbin/ip addr replace 172.16.42.1/24 dev usb0
ExecStartPre=-/usr/sbin/ip link set usb0 up
ExecStart=/usr/sbin/dnsmasq --no-daemon --port=0 --interface=usb0 --bind-dynamic --dhcp-range=172.16.42.2,172.16.42.2,255.255.255.0,12h --dhcp-option=3 --dhcp-option=6 --dhcp-leasefile=/run/fap-usb-dhcp.leases
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
