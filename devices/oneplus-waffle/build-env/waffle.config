# SPDX-License-Identifier: AGPL-3.0-or-later
# OnePlus 12 additions on top of kernels/qcom-sm8650/fap.config. Only used
# with the DaDDevil/linux waffle-voice tree (these drivers aren't upstream
# and don't exist in Fedora's 7.3.4 tree); fap-waffle-build.sh skips this
# file for KERNEL_TREE=fedora.
CONFIG_INPUT_QCOM_SPMI_HAPTICS=m

# Display path built in (first light without initramfs modules): the panel
# runs in DSI command mode, so the bootloader's splash buffer isn't refreshed
# once ABL is gone; simpledrm (=y in fap.config) only bridges until msm takes
# over. DRM_MSM's "X || X=n" dependencies (LLCC, OCMEM, SMEM, AOSS_QMP) and
# what they need to probe (hwspinlock, IPCC mailbox) must be =y as well.
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_DRM_PANEL_BOE_AA545=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_SM_DISPCC_8550=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_SMEM=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_MDT_LOADER=y
# dispcc (af00000) takes the DP link/VCO clocks from the USB/DP QMP combo PHY
# (88e8000, okay in the board DT, supplies l3i/l3g there) and defers until it
# probes, holding back MDSS. Built in as a clock provider only: it is not in
# dwc3's phys list and DP0 stays disabled. COMBO's "TYPEC || TYPEC=n" needs
# TYPEC=y for that (TYPEC drivers themselves stay modules).
CONFIG_TYPEC=y
CONFIG_PHY_QCOM_QMP_COMBO=y

# v5. reboot-mode: pmk8550.dtsi's nvmem-reboot-mode on the PMK8550 SDAM cell
# (mode-bootloader = 2), so "systemctl reboot --reboot-argument=bootloader"
# lands in ABL fastboot. Built in so it works from the debug initramfs too.
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_POWER_RESET_QCOM_PON=y
# Touch (SPI4, Synaptics S3910; boots its own firmware from flash).
CONFIG_TOUCHSCREEN_SYNAPTICS_S3910=y
CONFIG_SPI_QCOM_GENI=y
# Fedora's linux-firmware/atheros-firmware ship .xz files (ath12k WCN7850);
# arm64 defconfig (slim build) can't load them. Fedora's own config has these.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# v6 audio (WCD9395 path; modules, loaded by udev from the DT/GPR devices in
# the netroot). arm64 defconfig already has all of these; listed so the
# fragment check fails if one ever disappears. Not the TFA9874 speaker amps:
# no driver exists (README.md, Audio).
CONFIG_QCOM_APR=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SND_SOC_WCD939X_SDW=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SND_SOC_LPASS_WSA_MACRO=m
CONFIG_PINCTRL_SM8650_LPASS_LPI=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m

# v6: rmtfs shared memory (reserved-memory rmtfs@d7c00000, client-id 1, from
# sm8650.dtsi) built in: v5's fap-modem-ram asked for a module name that
# doesn't exist (it's rmtfs_mem.ko) and the modem stayed offline. Built in,
# /dev/qcom_rmtfs_mem1 is there before rmtfs starts.
CONFIG_QCOM_RMTFS_MEM=y

# v7 GPU (Adreno 750, msm/freedreno). The GPU is a component of the msm DRM
# device, and its GMU needs gpucc's clocks and GDSCs to bind: with gpucc as a
# module the whole msm device (display included) would wait for the netroot.
# Built in so display + GPU bind at boot; firmware (SQE, GMU, zap) is only
# requested at the first open of the DRM device, from the root filesystem.
CONFIG_SM_GPUCC_8650=y
# v7 Wi-Fi/Bluetooth power sequencing (WCN7850 PMU; the shutdown hook is
# kernels/qcom-sm8650/patches/0001-*) and Bluetooth over UART14 (hci_qca,
# qcom,wcn7850-bt). Already in arm64 defconfig; listed so the check catches a
# change.
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=m
CONFIG_PCI_PWRCTRL_PWRSEQ=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m
# v7 video codec (Iris, vpu33) + its clock controller (sm8650 videocc lives
# in videocc-sm8550.c).
CONFIG_VIDEO_QCOM_IRIS=m
CONFIG_SM_VIDEOCC_8550=m
# Dual-boot install (INSTALL.md section 3): tiny-init maps the logical
# partition fap_root from super's LP metadata with dm-linear (fap-lpmap)
# before any module is loaded, so device-mapper is built in (dm-linear is
# part of dm-mod). UFS BSG for qbootctl's boot-LUN switch (bBootLunEn).
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_SCSI_UFS_BSG=y
# Waydroid (layers/waydroid). This tree (7.4-rc) has only the Rust binder
# (ANDROID_BINDER_IPC_RUST, binderfs built in; the C binder and
# ANDROID_BINDERFS are gone), so Rust support is needed, as in Fedora's own
# kernel (GCC + rustc). Needs rust, rust-src, bindgen-cli, clang-libs in the
# build container. PSI for Android's lmkd, nftables/NAT for its network.
CONFIG_RUST=y
CONFIG_ANDROID_BINDER_IPC_RUST=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_PSI=y
CONFIG_NF_TABLES=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NF_TABLES_INET=y
# Waydroid networking: Android's netd needs policy routing (one routing
# table per network; without it "Error adding IPv4 rule: Operation not
# supported", no default route) and legacy iptables/ip6tables with the
# filter/mangle/raw tables and the matches its rules use (2026-11-20).
# Since 6.17 the legacy tables sit behind NETFILTER_XTABLES_LEGACY.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_QUOTA=m
CONFIG_NETFILTER_XT_MATCH_LENGTH=m
CONFIG_NETFILTER_XT_MATCH_HELPER=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_NETFILTER_XT_MATCH_U32=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
# Power (branch oneplus12-power). /sys/power/pm_test (staged suspend tests:
# freezer, devices, platform, processors, core) and suspend timing in dmesg.
# Suspend itself stays disabled in the root until those pass (POWER.md).
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# Listed so the fragment check catches a change: CPU DVFS (EPSS cpufreq-hw,
# schedutil), PSCI OSI cpuidle, CPU cooling, tsens, RPMh/AOSS sleep stats,
# PM8550 flash/torch LED.
CONFIG_ARM_QCOM_CPUFREQ_HW=m
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y
CONFIG_ENERGY_MODEL=y
CONFIG_CPU_THERMAL=y
CONFIG_QCOM_TSENS=m
CONFIG_QCOM_STATS=m
CONFIG_LEDS_QCOM_FLASH=m
