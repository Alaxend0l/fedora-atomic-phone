# SPDX-License-Identifier: AGPL-3.0-or-later
# OnePlus 12 additions on top of kernels/qcom-sm8650/fap.config. Only used
# with the DaDDevil/linux waffle-voice tree (these drivers aren't upstream
# and don't exist in Fedora's 7.3.4 tree); fap-waffle-build.sh skips this
# file for KERNEL_TREE=fedora.
CONFIG_TOUCHSCREEN_SYNAPTICS_S3910=m
CONFIG_INPUT_QCOM_SPMI_HAPTICS=m

# Display path built in (first light without initramfs modules): the panel
# runs in DSI command mode, so the bootloader's splash buffer isn't refreshed
# once ABL is gone; simpledrm (=y in fap.config) only bridges until msm takes
# over. DRM_MSM's "X || X=n" dependencies (LLCC, OCMEM, SMEM, AOSS_QMP) and
# what they need to probe (hwspinlock, IPCC mailbox) must be =y as well.
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_DRM_PANEL_BOE_AA545=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_SM_DISPCC_8550=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_SMEM=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_MDT_LOADER=y
# dispcc (af00000) takes the DP link/VCO clocks from the USB/DP QMP combo PHY
# (88e8000, okay in the board DT, supplies l3i/l3g there) and defers until it
# probes, holding back MDSS. Built in as a clock provider only: it is not in
# dwc3's phys list and DP0 stays disabled. COMBO's "TYPEC || TYPEC=n" needs
# TYPEC=y for that (TYPEC drivers themselves stay modules).
CONFIG_TYPEC=y
CONFIG_PHY_QCOM_QMP_COMBO=y
