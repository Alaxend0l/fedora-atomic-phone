# OnePlus 12 additions on top of kernels/qcom-sm8650/fap.config. Only used
# with the DaDDevil/linux waffle-voice tree (these drivers aren't upstream
# and don't exist in Fedora's 7.3.4 tree); fap-waffle-build.sh skips this
# file for KERNEL_TREE=fedora.
CONFIG_DRM_PANEL_BOE_AA545=m
CONFIG_TOUCHSCREEN_SYNAPTICS_S3910=m
CONFIG_INPUT_QCOM_SPMI_HAPTICS=m
