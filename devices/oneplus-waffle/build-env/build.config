# SPDX-License-Identifier: AGPL-3.0-or-later
# Build-only settings for our development kernels, applied last. They make the
# build fit the 2 GiB podman VM and the uniLoader memory layout; none of them
# is a Fedora policy change we'd want in a packaged kernel.
#
# No debug info / BTF: halves build time and memory, and the Image size
# matters (uniLoader copies the kernel to 0xa3200000 and lives at
# 0xa8010000, so image_size must stay below 78 MiB). Fedora's packaged kernel
# keeps both.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_BTF is not set
# Rust is allowed (waffle.config enables it for the Rust binder, Waydroid):
# the VM has 16 GiB now and the container ships rustc/bindgen. Keep the
# Image below the uniLoader limit above.
# Modules aren't signed here (MODULE_SIG stays on, as other options select
# it, but MODULE_SIG_FORCE is off: unsigned modules load and taint).
# CONFIG_MODULE_SIG_ALL is not set
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_SYSTEM_TRUSTED_KEYS=""
# Plain (uncompressed) modules: the tiny initramfs insmods them directly.
# CONFIG_MODULE_COMPRESS is not set
CONFIG_LOCALVERSION="-fap-waffle"
# CONFIG_LOCALVERSION_AUTO is not set
