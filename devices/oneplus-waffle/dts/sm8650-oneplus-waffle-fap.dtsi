/*
 * OnePlus 12 (waffle): first-light trim of the board DT, for RAM boots via
 * uniLoader (devices/oneplus-waffle/README.md). Our own file. It includes
 * the board DT from DaDDevil/linux waffle-voice (pinned in
 * build-env/fap-waffle-build.sh), which is read from that kernel tree at
 * build time and never copied into this repository: it carries no licence
 * line yet (research/mainline-status.md), so we must not redistribute it.
 *
 * What stays on (v6): simplefb until msm, MDSS/DSI panel, UFS, touch,
 * ADSP/CDSP/MPSS/IPA, pmic-glink, PCIe0 Wi-Fi, reboot-mode, the WCD9395
 * audio path (sound card, RX/TX SoundWire, LPASS macros), USB in device
 * mode (gadget), power/volume keys, ramoops. Off: GPU, video, DP, the
 * speaker amplifiers and their I2S link, cameras, Bluetooth, IR, flash LED,
 * haptics, the charger/redriver/USB-C-audio-switch I2C buses.
 */

#include "sm8650-oneplus-waffle.dts"

/ {
	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * The splash buffer ABL/UEFI leaves on the panel: 1440x3168
		 * ARGB8888 at 0xd5100000. Sources: uniLoader board-waffle.c
		 * (DaDDevil, simplefb at the same address) and ios-waffle's
		 * measured UEFI GOP reservation 0xd5100000-0xd7c00000 (dossier
		 * boot-and-flashing.md section 1). Stride 1440 * 4.
		 */
		framebuffer@d5100000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xd5100000 0x0 (1440 * 3168 * 4)>;
			memory-region = <&fap_splash>;
			width = <1440>;
			height = <3168>;
			stride = <(1440 * 4)>;
			format = "a8r8g8b8";
		};
	};

	reserved-memory {
		/* Keep the kernel out of the whole UEFI display reservation. */
		fap_splash: splash@d5100000 {
			reg = <0x0 0xd5100000 0x0 0x02b00000>;
			no-map;
		};
	};
};

/*
 * v6 audio: the board DT's sound card (qcom,sm8650-sndcard, AudioReach on
 * the ADSP) with its two WCD9395 links: RX_CODEC_DMA_RX_0 -> RX macro ->
 * SoundWire RX (swr1) -> WCD9395 HPH/EAR, and WCD9395 ADCs (AMIC1-5) ->
 * SoundWire TX (swr2) -> TX macro -> TX_CODEC_DMA_TX_3. Those are the same
 * back ends as SM8650-QRD, so the generic AudioReach topology from Fedora's
 * qcom-firmware serves them (netroot installs it as
 * qcom/sm8650/OnePlus 12-tplg.bin.xz: card driver "sm8650" + the board DT's
 * model "OnePlus 12"; the same names select the UCM config).
 *
 * Not the speakers: the board DT's third link sends SECONDARY_MI2S_RX to a
 * max98357a placeholder, but the real amplifiers are two NXP TFA9874 on
 * i2c_hub_7, which have no driver here (tfa989x knows 9890/9895/9897 only)
 * and need OnePlus's tuning container from the vendor partition (not in our
 * backup). Smart amps with a boost converter must not be run on guessed
 * settings, so the link, its pins and the placeholder go, and i2c_hub_7
 * stays off (below): the amplifiers are never touched.
 */
&{/sound} {
	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-names;
	/delete-node/ sec-mi2s-playback-dai-link;
};

/delete-node/ &max98357a;

/*
 * USB: device mode, high speed only. The board DT runs dwc3 as OTG with
 * role switching from pmic-glink (ADSP), which first light doesn't start;
 * peripheral mode needs no role source. Only the eUSB2 PHY (+ PM8550B
 * repeater, both built in) is used: the QMP USB3/DP combo PHY stays
 * out of dwc3's phys (no USB3 at first light); it is built in only as the
 * DP clock provider dispcc needs (build-env/waffle.config). USB 2.0 is
 * plenty for a shell and the netroot.
 */
&usb_1 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&usb_1_hsphy>;
	phy-names = "usb2-phy";
	/delete-property/ usb-role-switch;
};


/*
 * Display: MDSS + DSI0 + the BOE AA545 panel as the board DT has them (built
 * into the kernel). The panel is in command mode, so the splash buffer is
 * only a bridge (simpledrm) until msm takes over. DP is off: it needs the
 * QMP combo PHY and pmic-glink altmode, neither of which runs at first light,
 * and a DP controller that never binds would hold back the whole msm DRM
 * device. No GPU (needs zap firmware), no video.
 */
&mdss_dp0 { status = "disabled"; };
&gpu { status = "disabled"; };
&iris { status = "disabled"; };

/*
 * Bluetooth (UART14), cameras, and the speaker amplifiers' I2C bus (TFA9874
 * x2, see the audio comment above). swr1/swr2 (WCD9395 RX/TX) are on as of
 * v6, as the board DT has them.
 */
&uart14 { status = "disabled"; };
&camss { status = "disabled"; };
&cci0 { status = "disabled"; };
&cci1 { status = "disabled"; };
&i2c_hub_7 { status = "disabled"; };

/*
 * IR (SPI11), the I2C buses with charger/redriver/sensor parts. i2c3 also
 * holds the WCD9395 USB-C audio switch (wcd939x-usbss): analog headsets on
 * the USB-C port need it plus pmic-glink altmode, and the board DT doesn't
 * link the codec to it (no MBHC plug events). Later: the USB port is our
 * only link to the phone during RAM boots.
 */
&spi11 { status = "disabled"; };
&i2c3 { status = "disabled"; };
&i2c6 { status = "disabled"; };
&i2c9 { status = "disabled"; };

/* Flash LED and haptics: PMIC outputs, nothing to drive at first light. */
&pm8550_flash { status = "disabled"; };
&pm8550b_haptics { status = "disabled"; };

/*
 * v5: DSPs, pmic-glink (battery via ADSP), Wi-Fi (PCIe0 + WCN7850 PMU) and
 * touch (SPI4) as the board DT has them. Firmware comes from this unit's own
 * modem partition and is only installed into the (local, never published)
 * netroot tarball, as the partition ships it: .mdt + .bNN, so the modem and
 * IPA names point at the .mdt files (the board DT says .mbn, i.e. squashed).
 * CDSP isn't enabled in the board DT; same firmware directory.
 */
&remoteproc_mpss {
	firmware-name = "qcom/sm8650/oneplus/waffle/modem.mdt",
			"qcom/sm8650/oneplus/waffle/modem_dtb.mdt";
};

&ipa {
	firmware-name = "qcom/sm8650/oneplus/waffle/ipa_fws.mdt";
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm8650/oneplus/waffle/cdsp.mdt",
			"qcom/sm8650/oneplus/waffle/cdsp_dtb.mdt";
	status = "okay";
};
