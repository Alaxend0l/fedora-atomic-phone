/*
 * OnePlus 12 (waffle): power and display polish on top of
 * sm8650-oneplus-waffle-fap.dtsi (branch oneplus12-power). Our own file;
 * it references labels/paths of sm8650.dtsi and DaDDevil's board DT, which
 * is only read from the pinned kernel tree at build time (dts/README.md).
 * Included by the -netroot DT. Nothing here is verified on hardware yet.
 *
 * 1. CPU thermal throttling. sm8650.dtsi gives the CPU tsens zones only
 *    "hot"/"critical" trips (110/115 C): the kernel would do nothing until
 *    the critical shutdown (the N100 lesson), and only the EPSS LMh
 *    firmware limit sits in between. Add a passive trip at 90 C (5 C
 *    hysteresis) with the cluster's CPUs as cpufreq cooling devices
 *    (step_wise, re-evaluated every 100 ms while passive). One cooling
 *    device per cpufreq policy, registered on the policy's first CPU
 *    (qcom-cpufreq-hw, CPUFREQ_IS_COOLING_DEV). Clusters, from
 *    the qcom,freq-domain cells: cpu0-1 A520 (domain 0), cpu2-4 A720
 *    (domain 3), cpu5-6 A720 (domain 1), cpu7 X4 (domain 2). The GPU zones
 *    already throttle the GPU at 95 C (sm8650.dtsi gpuN_alert0).
 * 2. Flash/torch LED (PM8550 flash module, leds-qcom-flash). Board DT
 *    allows 500 mA torch and 2 A flash per LED (2 channels each); we cap
 *    torch at 100 mA and flash at 1 A per LED for a first test. Torch
 *    only lights when someone writes brightness in /sys/class/leds.
 */

/* 1. CPU passive trips + cooling maps */
&{/thermal-zones/cpu0-thermal} {
	polling-delay-passive = <100>;

	trips {
		fap_cpu0_alert: fap-cpu0-alert {
			temperature = <90000>;
			hysteresis = <5000>;
			type = "passive";
		};
	};

	cooling-maps {
		fap-map0 {
			trip = <&fap_cpu0_alert>;
			cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
		};
	};
};

