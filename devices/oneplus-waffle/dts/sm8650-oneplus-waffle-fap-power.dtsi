/* 2. Flash/torch LED, low current (fap.dtsi disables it; the board DT has 500 mA / 2 A) */
&pm8550_flash {
	status = "okay";

	led-0 {
		led-max-microamp = <100000>;
		flash-max-microamp = <1000000>;
	};

	led-1 {
		led-max-microamp = <100000>;
		flash-max-microamp = <1000000>;
	};
};
