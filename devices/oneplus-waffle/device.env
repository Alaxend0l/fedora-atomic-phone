# SPDX-License-Identifier: AGPL-3.0-or-later
# OnePlus 12 (`oneplus-waffle`). Device description: plain KEY="value", sourced
# by bash (no spaces around =) and read by tools/*.py with a simple parser, so
# keep one key per line and no shell logic.
#
# Created by tools/new-device.sh from devices/_template/. Every key is
# documented in place; tools/check-device.sh says which are required and checks
# formats. Keys marked "(not used by tooling yet)" record facts the boot
# tooling will need for modern phones (header v4 / Pixel-style split boot
# images); fill them in anyway, they're what the next person needs to know.
# Say how you found each value (stock image, getvar, live DT) in a comment.

# --- Identity ---------------------------------------------------------------
DEVICE_NAME="OnePlus 12"           # marketing name, e.g. "OnePlus Nord N100"
DEVICE_CODENAME="waffle"          # vendor's codename, e.g. billie2, shiba
DEVICE_SOC="qcom-sm8650"                    # SoC family; matches kernels/<soc>/ (qcom-sm6115, google-zuma)
# research | planned | boots | usable | daily | unmaintained
#   research      desk research only: no phone in hand, or nothing booted
#   planned       a port is being worked on
#   boots         our kernel boots and reaches a shell (a RAM boot counts)
#   usable        display, touch and a network work, booting from storage
#   daily         good enough as a daily phone (calls, audio, battery)
#   unmaintained  nobody owns it any more; images may stop being built
DEVICE_STATUS="research"
DEVICE_MAINTAINER="Alaxendol"
# What works lives in features.yaml (docs/features.md), not here.

# --- Kernel -----------------------------------------------------------------
# Where the kernel comes from:
#   fedora                       Fedora's kernel package (preferred: needs the
#                                SoC and board upstream)
#   git:<url>#<branch-or-tag>    an out-of-Fedora tree (SoC bring-up tree);
#                                KERNEL_BUILD_CONTAINER and KERNEL_CONFIG say
#                                how it's built (not used by tooling yet; the
#                                package lives in kernels/<soc>/). CI builds
#                                dts/ against this tree.
KERNEL_SOURCE="fedora"
KERNEL_BUILD_CONTAINER=""             # e.g. registry.fedoraproject.org/fedora:45
KERNEL_CONFIG=""                      # e.g. "defconfig kernels/<soc>/phone.config"
# Package installed in the image: "fedora" keeps Fedora's kernel; otherwise a
# package name from a repo shipped in rootfs/usr/share/dnf5/repos.d/.
KERNEL_PACKAGE="fedora"
# Device tree, relative to the kernel's dtb/ directory (upstream name). Our
# additions live in dts/ (tools/build-dtb.sh; RAMBOOT_DTB= to test them).
KERNEL_DTB="qcom/oneplus-waffle.dtb"
# Pixel/Exynos-style ABLs pick a base DTB by a /soc_compatible node instead of
# qcom,msm-id: one child per silicon revision and package, written as
# "label:product_id:major:minor:pkg_mode" (husky: "b0-foplp:0x9865:1:0:0").
# Empty for Qualcomm. (not used by tooling yet)
SOC_COMPATIBLE=""

# Drivers for the RAM-boot debug initramfs (boot/android-bootimg/make-ramboot.sh):
# what's needed to reach storage and bring USB up in device mode. Start from a
# phone with the same SoC; tiny-init's "deferred:" lines name what's missing
# (docs/porting-cookbook.md).
RAMBOOT_DRIVERS="libcomposite usb_f_acm u_serial usb_f_ncm ramoops"
RAMBOOT_INITRAMFS="tiny"              # tiny (busybox, a few MB) | dracut (~68 MB)

# --- Boot -------------------------------------------------------------------
# One of the folders under boot/ (boot/README.md says how to choose):
#   uboot-android    U-Boot in the boot partition → EFI → GRUB → kernel
#   android-bootimg  kernel + initramfs + DTB in the boot partition, re-flashed
#                    on kernel updates by fap-android-boot (A/B)
#   lk2nd            older Qualcomm phones (planned)
BOOT_METHOD="android-bootimg"

# uboot-android only: U-Boot config and the board DT in U-Boot's dts/upstream/.
UBOOT_DEFCONFIG="qcom_defconfig"
UBOOT_CONFIG_FRAGMENTS=""             # phones: "qcom-phone.config"
UBOOT_DTB=""                          # e.g. qcom/sm4250-oneplus-billie2
UBOOT_ENV_FILE=""                     # optional uboot.env in this folder

# Boot images the bootloader reads (`fastboot getvar all`, stock firmware):
#   older Qualcomm (header v0-v2):  "boot dtbo"
#   GKI / Pixel 6+ (header v4):     "boot init_boot vendor_boot vendor_kernel_boot dtbo"
BOOT_IMAGES="boot dtbo"

# Android boot image layout. Copy it from the stock image:
#   unpack_bootimg --boot_img boot.img --format mkbootimg
# Header v0-v2: everything below lives in boot.img. Header v3/v4: boot.img
# holds only the kernel (page size fixed at 4096); base, offsets, DTB and
# cmdline go into vendor_boot (unpack that too). Our tools build v0-v2 only
# so far (docs/porting-cookbook.md, Pixel/Tensor section).
BOOTIMG_HEADER_VERSION="2"            # 0 | 1 | 2 | 3 | 4
BOOTIMG_PAGESIZE="4096"
BOOTIMG_BASE="0x00000000"
BOOTIMG_KERNEL_OFFSET="0x00008000"
# Fedora's arm64 Image is ~77 MB uncompressed: ramdisk and DTB must sit above
# kernel_offset + the Image header's image_size, not at stock values
# (cookbook: "header v2 offsets for big kernels").
BOOTIMG_RAMDISK_OFFSET="0x06000000"
BOOTIMG_TAGS_OFFSET="0x00000100"
BOOTIMG_DTB_OFFSET="0x05800000"       # header v2 (and vendor_boot of v3/v4)
BOOTIMG_CMDLINE=""                    # extra kernel arguments
# Some bootloaders check these; copy them from the stock header.
BOOTIMG_OS_VERSION=""                 # e.g. 10.0.0
BOOTIMG_OS_PATCH_LEVEL=""             # e.g. 2020-10
# Where kernel arguments must go: "bootimg" (boot/vendor_boot cmdline) or
# "dtb" (/chosen/bootargs: some Pixel ABLs ignore the vendor cmdline).
CMDLINE_IN="bootimg"
# Header v4: page size of vendor_boot / vendor_kernel_boot (Pixel 8: 0x800).
VENDOR_BOOT_PAGESIZE=""
# "true" if the bootloader takes the DTB from vendor_kernel_boot (Pixel 8)
# rather than boot or vendor_boot. (not used by tooling yet)
VENDOR_KERNEL_BOOT="false"
# Which ramdisk the bootloader uses: boot | vendor_boot | init_boot. On GKI
# phones a ramdisk inside boot.img may be ignored for init_boot's.
RAMDISK_IN="boot"

# Verified boot. Some ABLs refuse images without an AVB footer even when
# unlocked (Pixel 8). Space-separated "partition:size", size from
# `fastboot getvar partition-size:<part>_a`, e.g. "boot:0x4000000 init_boot:0x800000".
AVB_FOOTERS=""
AVB_ROLLBACK_INDEX=""                 # from the stock footer (avbtool info_image)
AVB_SECURITY_PATCH=""                 # stock security patch level, YYYY-MM-DD

# dtbo partition: what the bootloader does with board overlays.
#   erase    erase dtbo (N100: ABL applies the stock overlay to any DT otherwise)
#   stock    leave the stock dtbo (its overlays must apply to our DT)
#   overlay  ship our own overlay for DTBO_BOARD_ID/DTBO_BOARD_REV (Pixel)
DTBO_MODE="erase"
DTBO_BOARD_ID=""                      # e.g. 0x40306 (mkdtimg --id); overlay mode
DTBO_BOARD_REV=""                     # e.g. 0x010000 (mkdtimg --rev)

# --- Flashing (fastboot) ----------------------------------------------------
FASTBOOT_PRODUCT=""                   # `fastboot getvar product` must contain this
FLASH_AB="true"                       # A/B slots? (boot_a/boot_b)
# Pin every write to one slot ("b" keeps stock on "a"), or "" for the active
# slot. Pixel: never switch slots unless both carry the same bootloader (ARB).
FLASH_SLOT=""
FLASH_BOOT_PARTITION="boot"           # gets the U-Boot or kernel image
FLASH_ERASE=""                        # partitions erased first (e.g. "dtbo")
FLASH_ESP_PARTITION=""                # gets the EFI system partition image
FLASH_ROOT_PARTITION="userdata"       # gets the root filesystem image
# Partitions never to write on this phone, on top of the shared list in
# tools/flash.sh (identity, boot chain, firmware; per-device list: tooling
# branch). Pixel adds e.g. "bl1 bl2 bl31 gsa ldfw pbl tzsw efs efs_backup".
PROTECTED_PARTITIONS=""
# Partitions to back up (dd + sha256) before the first write: identity and
# calibration (IMEI, RF), which no stock image restores.
BACKUP_PARTITIONS="modemst1 modemst2 fsg fsc persist"
# Way back to stock when fastboot is gone: edl | pixel-rom-recovery | none.
# Details in README.md "Recovery".
RECOVERY_METHOD=""

# --- Firmware ---------------------------------------------------------------
# Manifest of every blob this phone needs: where it lives on the phone, where
# it installs, whether it may be redistributed (format: docs/features.md).
FIRMWARE_MANIFEST="firmware.yaml"

# --- Disk image -------------------------------------------------------------
DISK_SECTOR_SIZE="4096"               # UFS: 4096; eMMC: usually 512
