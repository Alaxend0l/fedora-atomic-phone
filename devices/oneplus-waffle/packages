# OnePlus 12 (SM8650): what only this phone (or its SoC) needs.

# Qualcomm userspace for the modem: QRTR tools, EFS server (fap-modem-ram
# runs it read-only on RAM copies), TFTP for the modem's config files. The
# protection-domain mapper is the kernel's (qcom_pd_mapper), so no pd-mapper.
qrtr
rmtfs
tqftpserv

# WCN7850 (ath12k) Wi-Fi firmware and board data.
atheros-firmware

# Vulkan (turnip) for the Adreno 750; GL/GBM (freedreno) is mesa-dri-drivers
# from the desktop layer. GPU firmware: build-env/fap-waffle-build.sh.
mesa-vulkan-drivers

# Speakers (TFA9874): the look-ahead limiter of the PipeWire protection
# filter (installroot/usr/share/wireplumber/wireplumber.conf.d/50-fap-waffle-speaker-dsp.conf).
ladspa-swh-plugins

# Cameras: libcamera (simple pipeline + software ISP on CAMSS), its tools
# and V4L2 compat layer (libcamerify for Qt apps like Qrca), Plasma's
# libcamera camera app, PipeWire's libcamera plugin for browsers/portals.
libcamera
libcamera-ipa
libcamera-tools
libcamera-v4l2
v4l-utils
plasma-camera
pipewire-plugin-libcamera
