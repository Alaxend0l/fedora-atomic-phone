# OnePlus 12 (SM8650): what only this phone (or its SoC) needs.

# Qualcomm userspace for the modem: QRTR tools, EFS server (fap-modem-ram
# runs it read-only on RAM copies), TFTP for the modem's config files. The
# protection-domain mapper is the kernel's (qcom_pd_mapper), so no pd-mapper.
qrtr
rmtfs
tqftpserv

# WCN7850 (ath12k) Wi-Fi firmware and board data.
atheros-firmware

# Vulkan (turnip) for the Adreno 750; GL/GBM (freedreno) is mesa-dri-drivers
# from the desktop layer. GPU firmware: build-env/fap-waffle-build.sh.
mesa-vulkan-drivers

# Telephony (ModemManager, NetworkManager-wwan come from base): qmicli for
# read-only QMI checks over QRTR (TEL.md in the build output, docs).
libqmi-utils
