/*
 * OnePlus Nord N100: additions on top of mainline's sm4250-oneplus-billie2.dts,
 * kept here until they're upstreamed. Build: tools/build-dtb.sh.
 *
 * Adds the PMICs (PM6125 + PMI632, same pair as sm6115-fxtec-pro1x) and the
 * three keys. Key codes follow the vendor DT (verified 2026-11-20):
 *   kpdpwr (PON)            0x74 KEY_POWER
 *   resin  (PON type 1)     0x73 KEY_VOLUMEUP
 *   pm6125 GPIO 5, active low  0x72 KEY_VOLUMEDOWN  (vendor label says
 *                                "volume_up"; the code is what Android used)
 * Confirmed on hardware with evtest (2026-11-20): Power → KEY_POWER on
 * pm8941_pwrkey, Volume Up → KEY_VOLUMEUP on pm8941_resin, Volume Down →
 * KEY_VOLUMEDOWN on gpio-keys.
 *
 * Deliberately left disabled (they write hardware state; separate reviewed
 * steps): PMI632 VBUS regulator, Type-C, charger, LPG LEDs, vibrator.
 */

#include "sm4250-oneplus-billie2.dts"
#include "pm6125.dtsi"
#include "pmi632.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&vol_down_n>;
		pinctrl-names = "default";

		key-volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&pm6125_gpios 5 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};
};

&pm6125_gpios {
	vol_down_n: vol-down-n-state {
		pins = "gpio5";
		function = "normal";
		power-source = <0>;
		bias-pull-up;
		input-enable;
	};
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEUP>;
	status = "okay";
};

/*
 * Display: ILI9882N, 720x1600, DSI video mode, 4 lanes (vendor node
 * qcom,mdss_dsi_ili9882n_90hz_video). Driver: devices/oneplus-billie2/kmod/
 * panel-ili9882n (lmdpdg-generated). Reset is TLMM 82 (vendor
 * qcom,platform-reset-gpio), same as the Fxtec Pro1X.
 *
 * Supplies: the panel needs vddio (L9A, 1.8 V) and LCDB lab/ibb (+/-6.0 V on
 * PMI632). Mainline has no LCDB driver, so the panel driver doesn't manage
 * any supply: it relies on the bootloader having powered the panel (it has:
 * its splash is on screen). DSI vdda is L18A; vendor sets 1.232 V, within
 * mainline's 1.104-1.304 V for L18A, and the DSI driver only requests load.
 */
&mdss {
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l18a>;
	status = "okay";

	panel@0 {
		compatible = "oneplus,billie2-ili9882n";
		reg = <0>;

		reset-gpios = <&tlmm 82 GPIO_ACTIVE_LOW>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&mdss_dsi0_phy {
	status = "okay";
};

/*
 * Modem (MPSS) and Wi-Fi (WCN3990 via ath10k_snoc). The Wi-Fi firmware
 * (wlanmdsp.mbn) runs on the modem, so Wi-Fi needs the modem up, which needs
 * rmtfs (EFS), tqftpserv and the kernel PD mapper. Firmware comes from the
 * phone's own modem_a partition at run time (not redistributable); see
 * fap-modem-ram in the netroot. Supplies match the vendor icnss node
 * (L8A cx-mx, L16A xo, L17A rfa, L23A ch0), same as the Fxtec Pro1X.
 */
&remoteproc_mpss {
	firmware-name = "qcom/sm6115/OnePlus/billie2/modem.mdt";
	status = "okay";
};

&wifi {
	vdd-0.8-cx-mx-supply = <&vreg_l8a>;
	vdd-1.8-xo-supply = <&vreg_l16a>;
	vdd-1.3-rfa-supply = <&vreg_l17a>;
	vdd-3.3-ch0-supply = <&vreg_l23a>;

	qcom,calibration-variant = "OnePlus_billie2";

	status = "okay";
};
