# OnePlus Nord N100. See README.md in this folder for status and open questions.

# --- Identity ---------------------------------------------------------------
DEVICE_NAME="OnePlus Nord N100"
DEVICE_CODENAME="billie2"
DEVICE_SOC="qcom-sm6115"              # SM4250 is the SM6115 family (bengal)
DEVICE_STATUS="planned"
DEVICE_MAINTAINER="Alaxend0l"

# --- Kernel -----------------------------------------------------------------
# First experiment: Fedora's own kernel. Mainline has had this board's device
# tree since 2021 (by Iskren Chernev). Open question: does Fedora's aarch64
# config enable the SM6115 clock/pinctrl/interconnect drivers? See
# kernels/qcom-sm6115/README.md.
KERNEL_PACKAGE="fedora"
KERNEL_DTB="qcom/sm4250-oneplus-billie2.dtb"

# Drivers for the RAM-boot debug initramfs (boot/android-bootimg/make-ramboot.sh):
# what's needed to reach UFS and to bring up USB in device mode. dracut adds
# their dependencies.
RAMBOOT_DRIVERS="qcom_apcs_ipc_mailbox rpm_proc qcom_hwspinlock gpucc_sm6115 gcc-sm6115 pinctrl-sm6115 qnoc-sm6115 icc-smd-rpm smd-rpm clk-smd-rpm qcom_glink_rpm rpmpd qcom_smd-regulator qcom_spmi-regulator ufs-qcom phy-qcom-qmp-ufs dwc3 dwc3-qcom dwc3_qcom_legacy phy-qcom-qusb2 nvmem_qfprom phy-qcom-qmp-usbc libcomposite usb_f_acm u_serial usb_f_ncm ramoops qcom_tsens qcom_cpufreq_hw sdhci_msm qcom_rng"

# --- Boot -------------------------------------------------------------------
# uboot-android first (U-Boot upstream has SM6115 + this board). If U-Boot
# misbehaves, android-bootimg works with the same BOOTIMG_* layout.
BOOT_METHOD="uboot-android"
UBOOT_DEFCONFIG="qcom_defconfig"
# U-Boot's documented phone settings: no required serial console (the billie2
# DT has none; without this U-Boot panics and resets), hang instead of reset
# on panic, USB fastboot with `fastboot oem console` to read U-Boot's log.
UBOOT_CONFIG_FRAGMENTS="qcom-phone.config"
# No working buttons in U-Boot: boot straight into USB fastboot if there's no
# OS (see uboot.env).
UBOOT_ENV_FILE="uboot.env"
UBOOT_DTB="qcom/sm4250-oneplus-billie2"

# Android boot image layout. Stock/UBports images use kernel 0x8000, ramdisk
# 0x01000000, dtb 0x01f00000 (header v2). Fedora's kernel needs 76.5 MB from
# 0x8000 (arm64 header image_size 0x4c70000), which would overlap those, so the
# ramdisk and DTB sit above it. Fedora kernel + these offsets booted
# (2026-11-20, no ramdisk). U-Boot was tested with the stock offsets.
BOOTIMG_HEADER_VERSION="2"
BOOTIMG_PAGESIZE="4096"
BOOTIMG_BASE="0x00000000"
BOOTIMG_KERNEL_OFFSET="0x00008000"
BOOTIMG_RAMDISK_OFFSET="0x06000000"
BOOTIMG_TAGS_OFFSET="0x00000100"
BOOTIMG_DTB_OFFSET="0x05800000"
BOOTIMG_CMDLINE=""
# Copied from the stock boot_a header; testing whether ABL needs them.
BOOTIMG_OS_VERSION="10.0.0"
BOOTIMG_OS_PATCH_LEVEL="2020-10"

# --- Flashing (fastboot) ----------------------------------------------------
FASTBOOT_PRODUCT="bengal"             # what fastboot reports on this phone
FLASH_AB="true"
FLASH_BOOT_PARTITION="boot"
# ABL applies the stock QRD overlay to any DT and then won't start a mainline
# one; with dtbo erased it hands over (tested 2026-11-20, fresh session).
# Note: Ubuntu Touch/Android won't boot with dtbo erased.
FLASH_ERASE="dtbo"
# Not decided yet: there's no spare system_b (system lives inside the dynamic
# `super` partition). Candidates in README.md. Left empty so `just flash`
# refuses to run until it's chosen.
FLASH_ESP_PARTITION=""
FLASH_ROOT_PARTITION="userdata"       # 44.8 GiB

# --- Disk image -------------------------------------------------------------
DISK_SECTOR_SIZE="4096"               # UFS (Micron MT064GASAO2U21)
