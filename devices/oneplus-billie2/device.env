# OnePlus Nord N100. See README.md in this folder for status and open questions.

# --- Identity ---------------------------------------------------------------
DEVICE_NAME="OnePlus Nord N100"
DEVICE_CODENAME="billie2"
DEVICE_SOC="qcom-sm6115"              # SM4250 is the SM6115 family (bengal)
DEVICE_STATUS="planned"
DEVICE_MAINTAINER="Alaxend0l"

# --- Kernel -----------------------------------------------------------------
# First experiment: Fedora's own kernel. Mainline has had this board's device
# tree since 2021 (by Iskren Chernev). Open question: does Fedora's aarch64
# config enable the SM6115 clock/pinctrl/interconnect drivers? See
# kernels/qcom-sm6115/README.md.
KERNEL_PACKAGE="fedora"
KERNEL_DTB="qcom/sm4250-oneplus-billie2.dtb"

# --- Boot -------------------------------------------------------------------
# uboot-android first (U-Boot upstream has SM6115 + this board). If U-Boot
# misbehaves, android-bootimg works with the same BOOTIMG_* layout.
BOOT_METHOD="uboot-android"
UBOOT_DEFCONFIG="qcom_defconfig"
UBOOT_DTB="qcom/sm4250-oneplus-billie2"

# Layout of the stock/UBports boot images on this phone (UBports deviceinfo:
# kernel 0x8000, dtb 0x01f00000; header v2 with a separate DTB).
BOOTIMG_HEADER_VERSION="2"
BOOTIMG_PAGESIZE="4096"
BOOTIMG_BASE="0x00000000"
BOOTIMG_KERNEL_OFFSET="0x00008000"
BOOTIMG_RAMDISK_OFFSET="0x01000000"
BOOTIMG_TAGS_OFFSET="0x00000100"
BOOTIMG_DTB_OFFSET="0x01f00000"
BOOTIMG_CMDLINE=""

# --- Flashing (fastboot) ----------------------------------------------------
FASTBOOT_PRODUCT="bengal"             # what fastboot reports on this phone
FLASH_AB="true"
FLASH_BOOT_PARTITION="boot"
FLASH_ERASE="dtbo"
# Not decided yet: there's no spare system_b (system lives inside the dynamic
# `super` partition). Candidates in README.md. Left empty so `just flash`
# refuses to run until it's chosen.
FLASH_ESP_PARTITION=""
FLASH_ROOT_PARTITION="userdata"       # 44.8 GiB

# --- Disk image -------------------------------------------------------------
DISK_SECTOR_SIZE="4096"               # UFS (Micron MT064GASAO2U21)
