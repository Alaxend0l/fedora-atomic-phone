#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Record clock/frequency/bus state once per boot, to compare boots started in
# different ways (normal boot vs fastboot boot): /var/log/fap-boot-state/.
d=/var/log/fap-boot-state; mkdir -p "$d"
f="$d/$(date -u +%Y%m%dT%H%M%S)-$(tr -d - < /proc/sys/kernel/random/boot_id | cut -c1-8).txt"
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
{
    echo "== cmdline"; cat /proc/cmdline
    echo "== uptime"; cat /proc/uptime
    echo "== cpufreq"
    for p in /sys/devices/system/cpu/cpufreq/policy*; do
        echo "$p gov=$(cat $p/scaling_governor) cur=$(cat $p/scaling_cur_freq) min=$(cat $p/scaling_min_freq) max=$(cat $p/scaling_max_freq) hwmax=$(cat $p/cpuinfo_max_freq)"
    done
    echo "== devfreq"
    for p in /sys/class/devfreq/*; do
        echo "$p gov=$(cat $p/governor) cur=$(cat $p/cur_freq) min=$(cat $p/min_freq) max=$(cat $p/max_freq)"
    done
    echo "== thermal"
    for z in /sys/class/thermal/thermal_zone*; do echo "$(cat $z/type) $(cat $z/temp)"; done
    echo "== clk_summary (enabled, rate)"
    awk 'NR>3 && $2>0 {print $1, $2, $5}' /sys/kernel/debug/clk/clk_summary 2>/dev/null | head -400
    echo "== interconnect summary"
    cat /sys/kernel/debug/interconnect/interconnect_summary 2>/dev/null | head -200
    echo "== regulators"
    cat /sys/kernel/debug/regulator/regulator_summary 2>/dev/null | head -200
    echo "== usb"
    ls /sys/class/udc 2>&1; dmesg | grep -iE "dwc3|udc|qusb|usb" | tail -20
    echo "== bench"
    echo "mem: $(dd if=/dev/zero of=/dev/null bs=64M count=64 2>&1 | tail -1)"
    echo "tmpfs write: $(dd if=/dev/zero of=/dev/shm/fap-bench bs=16M count=64 conv=fdatasync 2>&1 | tail -1)"
    echo "tmpfs read: $(dd if=/dev/shm/fap-bench of=/dev/null bs=16M 2>&1 | tail -1)"
    rm -f /dev/shm/fap-bench
    echo "cpu sha256 256MB: $(head -c 268435456 /dev/zero | { TIMEFORMAT=%R; time sha256sum >/dev/null; } 2>&1)"
    echo "ufs read: $(dd if=/dev/disk/by-label/fap-root of=/dev/null bs=4M count=512 iflag=direct 2>&1 | tail -1)"
    echo "== dmesg errors"
    dmesg --level=err,warn | tail -60
} > "$f" 2>&1
echo "wrote $f"
