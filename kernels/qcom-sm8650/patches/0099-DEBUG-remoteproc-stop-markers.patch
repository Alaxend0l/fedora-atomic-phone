From: Alaxendol <alecjakopin@mailbox.org>
Subject: [PATCH] DEBUG: remoteproc stop-path markers (do not ship)

pr_emerg + mdelay(40) markers around every step of rproc_stop,
qcom_pas_stop, the GLINK subdev stop and each SSR BEFORE_SHUTDOWN
notifier, so netconsole shows the last step before the SoC reset seen on
any DSP stop (2026-11-21, ~/Develop/OnePlus12/log/2026-11-21-adsp-ssr-test.md).
Only for RAM-boot test builds; not in the series that gets flashed.

AI-assisted (Claude).

Upstream-Status: Inappropriate [debug only]
--- a/drivers/remoteproc/remoteproc_core.c
+++ b/drivers/remoteproc/remoteproc_core.c
@@ -18,6 +18,7 @@
 
 #include <asm/byteorder.h>
 #include <linux/delay.h>
+#define FAPDBG(fmt, ...) do { pr_emerg("fapdbg: " fmt "\n", ##__VA_ARGS__); mdelay(40); } while (0)
 #include <linux/device.h>
 #include <linux/dma-mapping.h>
 #include <linux/elf.h>
@@ -1123,8 +1124,11 @@
 		return;
 
 	list_for_each_entry_reverse(subdev, &rproc->subdevs, node) {
-		if (subdev->stop)
+		if (subdev->stop) {
+			FAPDBG("%s: subdev stop %ps", rproc->name, subdev->stop);
 			subdev->stop(subdev, crashed);
+			FAPDBG("%s: subdev stop %ps done", rproc->name, subdev->stop);
+		}
 	}
 
 	rproc->subdevs_started = false;
@@ -1135,8 +1139,11 @@
 	struct rproc_subdev *subdev;
 
 	list_for_each_entry_reverse(subdev, &rproc->subdevs, node) {
-		if (subdev->unprepare)
+		if (subdev->unprepare) {
+			FAPDBG("%s: subdev unprepare %ps", rproc->name, subdev->unprepare);
 			subdev->unprepare(subdev);
+			FAPDBG("%s: subdev unprepare %ps done", rproc->name, subdev->unprepare);
+		}
 	}
 }
 
@@ -1688,8 +1695,10 @@
 	if (!rproc->ops->stop)
 		return -EINVAL;
 
+	FAPDBG("%s: rproc_stop crashed=%d", rproc->name, crashed);
 	/* Stop any subdevices for the remote processor */
 	rproc_stop_subdevices(rproc, crashed);
+	FAPDBG("%s: subdevices stopped, reset rsc table", rproc->name);
 
 	/* the installed resource table is no longer accessible */
 	ret = rproc_reset_rsc_table_on_stop(rproc);
@@ -1700,7 +1709,9 @@
 
 
 	/* power off the remote processor */
+	FAPDBG("%s: ops->stop %ps", rproc->name, rproc->ops->stop);
 	ret = rproc->ops->stop(rproc);
+	FAPDBG("%s: ops->stop returned %d", rproc->name, ret);
 	if (ret) {
 		dev_err(dev, "can't stop rproc: %d\n", ret);
 		return ret;
--- a/drivers/remoteproc/qcom_q6v5_pas.c
