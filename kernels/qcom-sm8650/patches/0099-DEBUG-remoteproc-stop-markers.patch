--- a/drivers/remoteproc/qcom_common.c
+++ b/drivers/remoteproc/qcom_common.c
@@ -8,6 +8,8 @@
  */
 
 #include <linux/firmware.h>
+#include <linux/delay.h>
+#define FAPDBG(fmt, ...) do { pr_emerg("fapdbg: " fmt "\n", ##__VA_ARGS__); mdelay(40); } while (0)
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/notifier.h>
@@ -226,7 +228,9 @@
 {
 	struct qcom_rproc_glink *glink = to_glink_subdev(subdev);
 
+	FAPDBG("glink %s: smem unregister", glink->ssr_name);
 	qcom_glink_smem_unregister(glink->edge);
+	FAPDBG("glink %s: smem unregister done", glink->ssr_name);
 	glink->edge = NULL;
 }
 
@@ -481,8 +485,18 @@
 		.crashed = crashed,
 	};
 
-	srcu_notifier_call_chain(&ssr->info->notifier_list,
-				 QCOM_SSR_BEFORE_SHUTDOWN, &data);
+	{
+		struct notifier_block *nb;
+		int idx = srcu_read_lock(&ssr->info->notifier_list.srcu);
+
+		for (nb = srcu_dereference(ssr->info->notifier_list.head, &ssr->info->notifier_list.srcu);
+		     nb; nb = srcu_dereference(nb->next, &ssr->info->notifier_list.srcu)) {
+			FAPDBG("ssr %s: BEFORE_SHUTDOWN -> %ps", data.name, nb->notifier_call);
+			nb->notifier_call(nb, QCOM_SSR_BEFORE_SHUTDOWN, &data);
+			FAPDBG("ssr %s: BEFORE_SHUTDOWN %ps done", data.name, nb->notifier_call);
+		}
+		srcu_read_unlock(&ssr->info->notifier_list.srcu, idx);
+	}
 }
 
 static void ssr_notify_unprepare(struct rproc_subdev *subdev)
--- a/drivers/rpmsg/qcom_glink_smem.c
+++ b/drivers/rpmsg/qcom_glink_smem.c
@@ -3,6 +3,9 @@
  * Copyright (c) 2016, Linaro Ltd
  */
 
+#include <linux/delay.h>
+#define FAPDBG(fmt, ...) do { pr_emerg("fapdbg: " fmt "\n", ##__VA_ARGS__); mdelay(40); } while (0)
+extern int fapdbg_dd_on;
 #include <linux/io.h>
 #include <linux/module.h>
 #include <linux/of.h>
@@ -371,12 +374,17 @@
 {
 	struct qcom_glink *glink = smem->glink;
 
+	FAPDBG("smem: disable_irq");
+	WRITE_ONCE(fapdbg_dd_on, 1);
 	disable_irq(smem->irq);
-
+	FAPDBG("smem: native_remove");
 	qcom_glink_native_remove(glink);
-
+	FAPDBG("smem: mbox_free_channel");
 	mbox_free_channel(smem->mbox_chan);
+	FAPDBG("smem: device_unregister");
 	device_unregister(&smem->dev);
+	FAPDBG("smem: unregister done");
+	WRITE_ONCE(fapdbg_dd_on, 0);
 }
 EXPORT_SYMBOL_GPL(qcom_glink_smem_unregister);
 
--- a/drivers/rpmsg/qcom_glink_native.c
+++ b/drivers/rpmsg/qcom_glink_native.c
@@ -3,6 +3,8 @@
  * Copyright (c) 2016-2017, Linaro Ltd
  */
 
+#include <linux/delay.h>
+#define FAPDBG(fmt, ...) do { pr_emerg("fapdbg: " fmt "\n", ##__VA_ARGS__); mdelay(40); } while (0)
 #include <linux/idr.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
@@ -1961,7 +1963,10 @@
 
 static int qcom_glink_remove_device(struct device *dev, void *data)
 {
+	FAPDBG("native: unregister child %s (driver %s)", dev_name(dev),
+	       dev->driver ? dev->driver->name : "-");
 	device_unregister(dev);
+	FAPDBG("native: child %s gone", dev_name(dev));
 
 	return 0;
 }
@@ -1987,7 +1992,9 @@
 		qcom_glink_intent_req_abort(channel);
 	spin_unlock_irqrestore(&glink->idr_lock, flags);
 
+	FAPDBG("native: remove children");
 	ret = device_for_each_child(glink->dev, NULL, qcom_glink_remove_device);
+	FAPDBG("native: children removed, release channels");
 	if (ret)
 		dev_warn(glink->dev, "Can't remove GLINK devices: %d\n", ret);
 
--- a/drivers/base/dd.c
+++ b/drivers/base/dd.c
@@ -19,6 +19,7 @@
 #include <linux/debugfs.h>
 #include <linux/device.h>
 #include <linux/delay.h>
+#define FAPDBG_DD(fmt, ...) do { pr_emerg("fapdbg: " fmt "\n", ##__VA_ARGS__); mdelay(40); } while (0)
 #include <linux/dma-map-ops.h>
 #include <linux/init.h>
 #include <linux/module.h>
@@ -1323,12 +1324,18 @@
  * __device_release_driver() must be called with @dev lock held.
  * When called for a USB interface, @dev->parent lock must be held as well.
  */
+int fapdbg_dd_on;
+EXPORT_SYMBOL_GPL(fapdbg_dd_on);
+
 static void __device_release_driver(struct device *dev, struct device *parent)
 {
 	struct device_driver *drv;
 
 	drv = dev->driver;
 	if (drv) {
+		/* only log while a DSP teardown is in progress (fapdbg_dd_on) */
+		if (READ_ONCE(fapdbg_dd_on))
+			FAPDBG_DD("release %s (%s): pm get", dev_name(dev), drv->name);
 		pm_runtime_get_sync(dev);
 
 		while (device_links_busy(dev)) {
@@ -1354,7 +1361,11 @@
 
 		pm_runtime_put_sync(dev);
 
+		if (READ_ONCE(fapdbg_dd_on))
+			FAPDBG_DD("release %s (%s): remove", dev_name(dev), drv->name);
 		device_remove(dev);
+		if (READ_ONCE(fapdbg_dd_on))
+			FAPDBG_DD("release %s (%s): removed", dev_name(dev), drv->name);
 
 		if (dev->bus && dev->bus->dma_cleanup)
 			dev->bus->dma_cleanup(dev);
