# SPDX-License-Identifier: AGPL-3.0-or-later
# Config fragment for Qualcomm SM8650 phones (first device: OnePlus 12,
# devices/oneplus-waffle), applied on top of Fedora's own aarch64 config
# (kernel-aarch64-fedora.config from the kernel src.rpm) with
# scripts/kconfig/merge_config.sh, then `make olddefconfig`.
# devices/oneplus-waffle/build-env/fap-waffle-build.sh checks afterwards that
# every line below survived olddefconfig (a typo or a missing dependency
# fails the build instead of silently dropping out).
#
# Policy: =m wherever Fedora's policy allows (Fedora builds SoC drivers as
# modules); =y only for what the debug initramfs needs before it can load
# anything: pins, interconnect, clocks, UFS, USB device mode and the gadget
# functions tiny-init uses, and ramoops (crash logs from the first boot).
#
# Every symbol was checked to exist in both Fedora's 7.3.4 tree and
# DaDDevil/linux waffle-voice (v7.4-rc3) on 2026-11-20. Fedora 45 (7.3.4-300)
# has PINCTRL_SM8650 and INTERCONNECT_QCOM_SM8650 unset, so its kernel can't
# reach UFS or USB on SM8650 (kernels/qcom-sm8650/README.md).

# --- SoC core: built in (everything else hangs off these) -------------------
CONFIG_PINCTRL_SM8650=y
CONFIG_INTERCONNECT_QCOM_SM8650=y
CONFIG_SM_GCC_8650=y
CONFIG_SM_TCSRCC_8650=y
# Already =y in Fedora; listed so the check catches a policy change.
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_SCM=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y

# --- Storage: UFS built in (fap.root= without modules) ----------------------
# SCSI_UFSHCD "depends on RPMB || !RPMB": Fedora's RPMB=m caps it at m.
CONFIG_RPMB=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# --- USB device mode: built in ----------------------------------------------
# SM8650: DWC3 (qcom,sm8650-dwc3) + Synopsys eUSB2 PHY (qcom,sm8650-snps-eusb2-phy,
# driver phy-snps-eusb2 = PHY_SNPS_EUSB2; Fedora's PHY_QCOM_SNPS_EUSB2 no
# longer exists) + PM8550B eUSB2 repeater on SPMI + QMP USB3/DP combo PHY.
# The M31 eUSB2 PHY is SM8750's, not needed here. The QMP combo PHY
# "depends on TYPEC || TYPEC=n" and Fedora has TYPEC=m, so it stays a module;
# first light runs USB at high speed on the eUSB2 PHY alone (the waffle DT
# drops the usb3 phy), so dwc3 doesn't wait for it.
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y

# --- Display: bootloader framebuffer (simple-framebuffer at 0xd5100000) -----
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- Crash logs: ramoops at 0x85000000 (devices/oneplus-waffle DT) ----------
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# --- Everything else on SM8650: modules -------------------------------------
CONFIG_PINCTRL_SM8650_LPASS_LPI=m
# dispcc-sm8550.c and videocc-sm8550.c also drive SM8650 (qcom,sm8650-dispcc,
# qcom,sm8650-videocc). Fedora's SM_DISPCC_8650=m is a stale symbol that no
# longer exists, so Fedora has no SM8650 display clock driver at all.
CONFIG_SM_DISPCC_8550=m
CONFIG_SM_VIDEOCC_8550=m
CONFIG_SM_GPUCC_8650=m
CONFIG_SM_CAMCC_8650=m
CONFIG_QCOM_SMEM=m
CONFIG_QCOM_AOSS_QMP=m
CONFIG_QCOM_IPCC=m
CONFIG_QCOM_SOCINFO=m
CONFIG_QCOM_LLCC=m
CONFIG_ARM_QCOM_CPUFREQ_HW=m
CONFIG_QCOM_TSENS=m
CONFIG_QCOM_SPMI_ADC5_GEN3=m
CONFIG_QCOM_SPMI_TEMP_ALARM=m
CONFIG_RTC_DRV_PM8XXX=m
CONFIG_INPUT_PM8941_PWRKEY=m
CONFIG_KEYBOARD_GPIO=m
CONFIG_HW_RANDOM_QCOM=m
CONFIG_QCOM_PMIC_GLINK=m
CONFIG_UCSI_PMIC_GLINK=m
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_TYPEC_MUX_WCD939X_USBSS=m
CONFIG_TYPEC_MUX_NB7VPQ904M=m
CONFIG_PHY_QCOM_QMP_COMBO=m
CONFIG_DRM_MSM=m
